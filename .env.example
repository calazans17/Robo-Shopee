# Credenciais da API de Afiliados da Shopee (Shopee Open Platform)
# Pega em https://open-api.affiliate.shopee.com.br/ (App ID e App Secret)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Endpoint da API (BR normalmente e este)
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# ID do grupo de WhatsApp (formato: 123456789-123456789@g.us)
# Roda "npm run list-groups" depois de logar pra descobrir o ID certo
WHATSAPP_GROUP_ID=

# Horario diario de envio, formato cron (min hora * * *)
# Exemplo: "0 9 * * *" = todo dia as 09:00
SCHEDULE_CRON=0 9 * * *

# Quantas ofertas mandar por dia
OFFERS_PER_DAY=5

# Palavras-chave/categoria para buscar ofertas (opcional, deixe vazio para ofertas gerais)
SHOPEE_KEYWORD=
